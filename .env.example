# Optional. Leave blank to skip analytics.
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Sanity CMS Configuration
# ---------------------------------------------------------------------------
# Obtain these from https://www.sanity.io/manage
# 1. Project ID (from project dashboard):
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
# 2. Dataset name (default: production):
NEXT_PUBLIC_SANITY_DATASET=production
# 3. API Version (date formatted YYYY-MM-DD):
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# 4. Read token for webhooks & drafts (sanity.io/manage -> API -> Tokens):
SANITY_API_READ_TOKEN=
